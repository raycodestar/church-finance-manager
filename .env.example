# Copy this file to .env and replace only the values in that local file.
# .env is ignored by Git and is read by the Secrets Gradle Plugin.
#
# These names become BuildConfig.SUPABASE_URL and
# BuildConfig.SUPABASE_ANON_KEY when the app needs its Supabase client.
# A Supabase anonymous key is a public client credential; protect data with
# Row Level Security and never put a service-role key in an Android app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anonymous-key
